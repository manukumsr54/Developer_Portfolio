# ==========================================
# Developer Portfolio — Backend Environment Configuration
# ==========================================
#
# Enter these in your Vercel Project Settings -> Environment Variables
# for the Backend project (e.g. manu-developer-portfolio-api).

# Server / Environment
NODE_ENV=production
PORT=3001

# ------------------------------------------
# 1. FRONTEND CORS ORIGIN (Required for production)
# ------------------------------------------
# Set this to your live frontend Vercel domain (without trailing slash):
# Example: https://manu-developer-portfolio.vercel.app
FRONTEND_URL=https://manu-developer-portfolio.vercel.app

# ------------------------------------------
# 2. CONTACT EMAIL SYSTEM (Required for live email delivery)
# ------------------------------------------
# Recipient address where submitted portfolio inquiries are delivered:
MAIL_TO=manukumsr54@gmail.com

# OPTION A: Gmail App Password (Recommended & Simplest)
# 1. In your Google Account: Security -> 2-Step Verification -> App passwords
# 2. Generate a 16-character password for "Portfolio"
# 3. Enter the 16-character password below:
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# OPTION B: Generic SMTP Provider (Resend, SendGrid, Mailgun, Brevo, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=manukumsr54@gmail.com
# SMTP_PASSWORD=your_smtp_password

# ------------------------------------------
# 3. POSTGRESQL DATABASE (Recommended for message persistence)
# ------------------------------------------
# Connection string from Neon, Supabase, Vercel Postgres, or cloud PostgreSQL:
# Example: postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If omitted, submissions will still be safely emailed and logged in server memory.
# DATABASE_URL=
