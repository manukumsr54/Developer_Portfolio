# ==========================================
# Frontend Environment Configuration
# ==========================================
#
# Production (Vercel):
# Set this in Vercel Project Settings -> Environment Variables
# to your backend Vercel deployment URL (without trailing slash):
# VITE_API_BASE_URL=https://manu-developer-portfolio-api.vercel.app
#
# Local Development:
# Leave empty or omit to let Vite proxy requests to http://localhost:3001
VITE_API_BASE_URL=
